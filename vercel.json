{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "consent.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "requisites.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "crons": [
    {
      "path": "/api/internal/recovery",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(data|uploads|src|blocks|test|deploy|scripts|node_modules)(/.*)?", "status": 404 },
    { "src": "/(\\..*|server|ecosystem\\.config|build|package|package-lock|README)(\\..*)?", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
