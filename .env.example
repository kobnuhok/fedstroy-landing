# Порт для локального сервера
PORT=8080

# Режим сохранения загруженных файлов (false = удалять после отправки в Telegram/Email)
KEEP_UPLOADED_FILES=false

# Токен бота Telegram от @BotFather (например: 7845123984:AAH9f_K7qL1kXyZ8a2bcDeF3GhI4JkLmNoP)
TELEGRAM_BOT_TOKEN=

# ID чата или группы (для лички: 123456789, для группы ПТО: -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=

# Email дублирования заявок (по умолчанию: kobnuhok@yandex.ru)
EMAIL_TO=kobnuhok@yandex.ru

# Настройки исходящей почты SMTP (для отправки через Яндекс / Mail.ru / корпоративный почтовик)
# Для Яндекс Почты: создайте "Пароль приложения" в Яндекс ID -> Безопасность -> Пароли приложений
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Секретный ключ для запуска фонового восстановления через cron / API (/api/internal/recovery, /api/internal/retry)
# В продакшене обязателен (Fail-Closed: при отсутствии секрета эндпоинты возвращают 503 Service Unavailable).
# Передается в заголовке запроса: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# -----------------------------------------------------------------------------------------
# ВНИМАНИЕ (152-ФЗ и информационная безопасность):
# Боевые токены TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID и пароли SMTP_PASS
# должны настраиваться исключительно на защищенном российском VPS-сервере.
# Запрещается добавлять боевые ключи в переменные окружения Vercel-проекта (Demo/Stateless).
# -----------------------------------------------------------------------------------------

