# Конфигурация сервера ООО «ФЕДСТРОЙ»
PORT=8080

# Интеграция с Telegram Bot (опционально)
# Чтобы заявки и файлы ТЗ падали в ваш Telegram:
# 1. Создайте бота через @BotFather и вставьте токен:
TELEGRAM_BOT_TOKEN=

# 2. Укажите ID вашего чата или группы (можно узнать через @userinfobot):
TELEGRAM_CHAT_ID=

# Настройки CORS (для работы в связке с внешними доменами / GitHub Pages)
# ALLOWED_ORIGINS=https://kobnuhok.github.io,http://localhost:8080
